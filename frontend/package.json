{
  "name": "democicd-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript http://localhost:8080/swagger/v1/swagger.json -o src/shared/api/generated/schema.d.ts",
    "generate:api:local": "openapi-typescript openapi/openapi.json -o src/shared/api/generated/schema.d.ts",
    "check:api": "openapi-typescript openapi/openapi.json -o src/shared/api/generated/schema.d.ts --check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^6.5.1",
    "axios": "^1.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
